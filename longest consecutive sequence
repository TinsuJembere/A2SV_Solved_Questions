class Solution:
    def longestConsecutive(self, nums: List[int]) -> int:
        if nums == []:
            return 0
        num_set = set(nums)
        max_consecutive = 0

        for x in num_set:
            if x - 1 not in num_set:
                curr = x
                curr_len = 1
                while curr + 1 in num_set:
                    curr_len += 1
                    curr += 1
                max_consecutive = max(max_consecutive, curr_len)

        return max_consecutive
        
