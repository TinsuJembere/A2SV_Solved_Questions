class Solution:
    def maximumCandies(self, candies: list[int], k: int) -> int:
        l = 1
        r = max(candies)  
        
        while l <= r:
            m = (l + r) // 2
            if m == 0: 
                l = 1
                break
                
            if sum(p // m for p in candies) >= k:
                l = m + 1
            else:
                r = m - 1
        return r
