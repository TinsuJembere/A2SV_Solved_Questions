class Solution:
    def decodeString(self, s: str) -> str:
        stack = []
        current_str = ""
        k = 0

        for char in s:
            if char.isdigit():
                k = k * 10 + int(char)  # handle multi-digit numbers

            elif char == '[':
                stack.append((current_str, k))
                current_str = ""
                k = 0

            elif char == ']':
                prev_str, num = stack.pop()
                current_str = prev_str + current_str * num

            else:  # letter
                current_str += char

        return current_str
