import sys
import bisect
input = sys.stdin.readline

def solve():
    t = int(input())
    for _ in range(t):
        n, m = map(int, input().split())
        a = list(map(int, input().split()))
        b = list(map(int, input().split()))
        
        b.sort()
        
        prev = -10**18  # very small number
        
        possible = True
        
        for x in a:
            best = float('inf')
            
            # Option 1: keep x
            if x >= prev:
                best = x
            
            # Option 2: use operation
            # need b[j] >= prev + x
            target = prev + x
            idx = bisect.bisect_left(b, target)
            
            if idx < m:
                flipped = b[idx] - x
                if flipped >= prev:
                    best = min(best, flipped)
            
            if best == float('inf'):
                possible = False
                break
            
            prev = best
        
        print("YES" if possible else "NO")

if __name__ == "__main__":
    solve()
