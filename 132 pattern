class Solution:
    def find132pattern(self, nums: List[int]) -> bool:
        stack = []  # a decreasing stack
        ak = -math.inf 

        for num in reversed(nums):
            if num < ak:
                return True
            while stack and stack[-1] < num:
                ak = stack[-1]
                stack.pop()
            stack.append(num)  

        return False


