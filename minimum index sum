class Solution:
    def findRestaurant(self, list1: List[str], list2: List[str]) -> List[str]:
        index2 = {s:i for i, s in enumerate(list2)}
        min_sum = float('inf')
        ans = []

        for i, s in enumerate(list1):
            if s in index2:
                j =  index2[s]
                curr_sum = i + j
                if curr_sum < min_sum:
                    ans = [s]
                    min_sum = curr_sum
                elif curr_sum == min_sum:
                    ans.append(s)
       
        return ans
