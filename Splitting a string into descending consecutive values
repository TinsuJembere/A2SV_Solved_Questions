class Solution(object):
    def splitString(self, s):
        n = len(s)

        def dfs(index, prev):
            if index == n:
                return True

            num = 0
            for i in range(index, n):
                num = num * 10 + int(s[i])
                if num >= prev:
                    break
                if prev - num == 1:
                    if dfs(i + 1, num):
                        return True
            return False

        for i in range(1, n):
            if dfs(i, int(s[:i])):
                return True

        return False
