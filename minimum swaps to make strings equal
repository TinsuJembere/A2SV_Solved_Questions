class Solution:
    def minimumSwap(self, s1: str, s2: str) -> int:
        res = 0
        xy = 0
        yx = 0
        for i in range(len(s1)):
            if s1[i] == s2[i]:
                continue
            if s1[i] == "x" and s2[i] == 'y':
                xy += 1
            else:
                yx += 1
        if (xy + yx) % 2 != 0:
            return -1
        res = (xy // 2) + (yx // 2) + 2 * (xy % 2)
        return res

        
