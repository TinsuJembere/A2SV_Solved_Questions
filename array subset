from collections import Counter
class Solution:
    #Function to check if a is a subset of b.
    def isSubset(self, a, b):
        # Your code here
        counter_a = Counter(a)
        counter_b = Counter(b)
        for i in b:
            if counter_a[i] < counter_b[i]:
                return False
                
        return True
    
    
    
    
