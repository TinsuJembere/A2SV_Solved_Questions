class Solution:
    def maxArea(self, height: List[int]) -> int:
        n = len(height)
        max_water = 0
        l, r = 0, n - 1

        while l < r:
            curr_water = (r - l) * min(height[l], height[r])
            max_water = max(max_water, curr_water)
            if height[r] > height[l]:
                l += 1
            else:
                r -= 1
        return max_water
