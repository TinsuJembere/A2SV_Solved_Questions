class Solution:
    def flipAndInvertImage(self, image: List[List[int]]) -> List[List[int]]:
        row, col = len(image), len(image[0])
        for i in range(row):
            for j in range(col):
                image[i][j] = 1 - image[i][j]
        for i in range(row):
            image[i] = image[i][::-1]
        return image
