import sys
input = sys.stdin.readline

MAX = 200005

n, k, q = map(int, input().split())

cnt = [0] * MAX

for _ in range(n):
    l, r = map(int, input().split())
    cnt[l] += 1
    if r + 1 < MAX:
        cnt[r + 1] -= 1

for i in range(1, MAX):
    cnt[i] += cnt[i - 1]

pref = [0] * MAX
for i in range(1, MAX):
    pref[i] = pref[i - 1]
    if cnt[i] >= k:
        pref[i] += 1

for _ in range(q):
    a, b = map(int, input().split())
    print(pref[b] - pref[a - 1])
