from collections import Counter

class Solution:
    def customSortString(self, order: str, s: str) -> str:
        counter = Counter(s)
        res = []

        for ch in order:
            if ch in s:
                res.append(ch * counter[ch])
                del counter[ch]
        for ch, freq in counter.items():
            res.append(ch * freq)
        return "".join(res)

        
