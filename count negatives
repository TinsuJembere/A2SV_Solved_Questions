class Solution:
    def countNegatives(self, grid: List[List[int]]) -> int:
        negatives = 0
        m, n = len(grid), len(grid[0])
        row = 0
        col = n - 1
        while col >= 0 and row < m:
            if grid[row][col] < 0:
                negatives += m - row
                col -= 1
            else:
                row += 1
        return negatives
