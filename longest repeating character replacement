class Solution:
    def characterReplacement(self, s: str, k: int) -> int:
        freq = {}
        l = 0
        maxf = 0

        for r in range(len(s)):
            freq[s[r]] = freq.get(s[r], 0) + 1
            max_freq = max(freq.values())
            most_common_char = max(freq, key=freq.get)
            window = s[l:r + 1]
            
            while (r - l + 1) - max_freq > k:
                freq[s[l]] -= 1
                if freq[s[l]] == 0:
                    del freq[s[l]]
                l += 1

            maxf = max(maxf, r - l + 1)

        return maxf
            


