class Solution:
    def removeComments(self, source: List[str]) -> List[str]:
        res = []
        new_line = ""
        in_block_comment = False

        for line in source:
            i = 0
            while i < len(line):
                if in_block_comment:
                    if line[i:i+2] == "*/":
                        in_block_comment = False
                        i += 2
                    else:
                        i += 1
                else:
                    if line[i:i+2] == "/*":
                        in_block_comment = True
                        i += 2
                    elif line[i:i+2] == "//":
                        break
                    else:
                        new_line += line[i]
                        i += 1
            if not in_block_comment and new_line:
                res.append(new_line)
                new_line = ""
        return res
                        
