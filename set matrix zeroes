class Solution:
    def setZeroes(self, matrix: List[List[int]]) -> None:
        row, col = len(matrix), len(matrix[0])
        first_col_zero = False
        first_row_zero = False

        # Check first column
        for i in range(row):
            if matrix[i][0] == 0:
                first_col_zero = True

        # Check first row
        for j in range(col):
            if matrix[0][j] == 0:
                first_row_zero = True

        # Use first row and column as markers
        for i in range(1, row):
            for j in range(1, col):
                if matrix[i][j] == 0:
                    matrix[i][0] = 0
                    matrix[0][j] = 0

        # Zero inner matrix based on markers
        for i in range(1, row):
            for j in range(1, col):
                if matrix[i][0] == 0 or matrix[0][j] == 0:
                    matrix[i][j] = 0

        # Zero first row if needed
        if first_row_zero:
            for j in range(col):
                matrix[0][j] = 0

        # Zero first column if needed
        if first_col_zero:
            for i in range(row):
                matrix[i][0] = 0
